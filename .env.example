# Reference environment template.
# The application reads environment files from its component directories.
# Copy apps/api/.env.example to apps/api/.env.
# Copy infra/litellm/.env.example to infra/litellm/.env.

# API environment keys
# LITELLM_BASE_URL=http://127.0.0.1:4000/v1
# LITELLM_API_KEY=replace-me
# LITELLM_MODEL=
# DB_HOST=127.0.0.1
# DB_PORT=5433
# DB_NAME=
# DB_USER=
# DB_PASSWORD=replace-me
# JWT_SECRET_KEY=replace-me
# JWT_ALGORITHM=replace-me
# ACCESS_TOKEN_EXPIRE_MINUTES=replace-me

# LiteLLM environment keys
# LITELLM_MASTER_KEY=replace-me
# LITELLM_SALT_KEY=
# POSTGRES_PASSWORD=replace-me
# UI_USERNAME=
